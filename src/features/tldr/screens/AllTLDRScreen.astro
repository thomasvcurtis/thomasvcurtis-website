---
import Heading from '@/components/Heading.astro';
import { useTranslations } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { EmptyState } from '@/components/empty-state';
import TLDRCard from '../components/TLDRCard.astro';

type Props = {
  tldrEntries: CollectionEntry<'tldr'>[];
  lang: 'en';
};

const { tldrEntries, lang } = Astro.props;
const t = useTranslations(lang, 'tldrPage');

const pageTitle = t('pageTitle');
const pageDescription = t('pageDescription');
---

<BaseLayout {pageTitle} {pageDescription}>
  <div class="container mx-auto px-4 lg:px-8 py-8 md:py-12">
    <Heading title={t('title')} description={t('description')} />
    
    <div class="flex flex-col gap-4 mt-8 w-full">
      {
        tldrEntries.length > 0 ? (
          // Sort entries by date, most recent first
          tldrEntries
            .sort((a, b) => new Date(b.data.readDate).getTime() - new Date(a.data.readDate).getTime())
            .map((entry) => (
              <TLDRCard entry={entry} lang={lang} />
            ))
        ) : (
          <EmptyState
            title={t('noEntriesFound')}
          />
        )
      }
    </div>
  </div>
</BaseLayout>
