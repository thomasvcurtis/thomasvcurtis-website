---
import { Badge } from '@/components/ui/badge';
import {
  Card,
  CardTitle,
} from '@/components/ui/card';
import type { LanguageCode } from '@/i18n/ui';
import { useTranslations } from '@/i18n/ui';
import { formatDate } from '@/lib/utils';
import type { CollectionEntry } from 'astro:content';
import { Calendar } from 'lucide-react';

interface Props {
  entry: CollectionEntry<'tldr'> & { slug: string };
  lang: LanguageCode;
}

const { entry, lang } = Astro.props;
const t = useTranslations(lang, 'tldrPost');
---

<a
  href={`/tldr/${entry.slug}`}
  class="block group rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
>
  <Card className="hover:shadow-md transition-shadow duration-300">
    <div class="flex flex-col sm:flex-row justify-between gap-6 p-6">
      <div class="flex-grow space-y-4">
        <div class="space-y-3">
          <CardTitle className="text-xl font-semibold group-hover:text-primary transition-colors">
            {entry.data.title}
          </CardTitle>
          
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <span>by: {entry.data.author}</span>
            <span>•</span>
            <span class="flex items-center gap-1">
              <Calendar className="size-4" />
              {formatDate(entry.data.readDate, lang)}
            </span>
          </div>

          <a 
            href={entry.data.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:underline break-all inline-flex items-center"
          >
            {entry.data.sourceUrl}
          </a>
        </div>

        {entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex gap-2 pt-2 flex-wrap">
            {entry.data.tags.slice(0, 3).map((tag: string) => (
              <Badge variant="secondary" className="text-xs">
                {tag}
              </Badge>
            ))}
            {entry.data.tags.length > 3 && (
              <Badge variant="secondary" className="text-xs">
                +{entry.data.tags.length - 3}
              </Badge>
            )}
          </div>
        )}
      </div>

      </div>
    </div>
  </Card>
</a>
